# ============================================================================
# UTILITIES
# ============================================================================

# Show statistics for all data and vignettes
stats:
    #!/usr/bin/env bash
    echo "=== Extracted PRs ==="
    for f in data/prs-*-extracted-*.jsonl; do
        if [ -f "$f" ]; then
            count=$(wc -l < "$f" | tr -d ' ')
            echo "  $f: $count PRs"
        fi
    done
    echo ""
    echo "=== Review Cases ==="
    for f in data/prs-*-cases-*.jsonl; do
        if [ -f "$f" ]; then
            count=$(wc -l < "$f" | tr -d ' ')
            echo "  $f: $count cases"
        fi
    done
    echo ""
    echo "=== Vignettes ==="
    for d in vignettes/*/; do
        if [ -d "$d" ]; then
            count=$(find "$d" -name "*.md" | wc -l | tr -d ' ')
            echo "  $d: $count vignettes"
        fi
    done

# List available data files
list:
    @echo "=== Data Files ==="
    @ls -lh data/*.jsonl 2>/dev/null || echo "  No data files"
    @echo ""
    @echo "=== Vignette Directories ==="
    @ls -d vignettes/*/ 2>/dev/null || echo "  No vignettes"

# Clean generated files (use with caution)
clean:
    @echo "This will remove all data and vignettes. Are you sure? (Ctrl+C to cancel)"
    @read -p "Press Enter to continue..."
    rm -rf data/*.jsonl vignettes/*/
