# Justfile for running ai4c-scribe analyses
# Run from the analyses/ directory

# Default limit for PR extraction
default_limit := "2000"

# Repository definitions
go_repo := "geneontology/go-ontology"
mondo_repo := "monarch-initiative/mondo"
uberon_repo := "obophenotype/uberon"
oeo_repo := "OpenEnergyPlatform/ontology"
efo_repo := "EBISPOT/efo"
cl_repo := "obophenotype/cell-ontology"

# Worktree paths (adjust these to your local setup)
go_worktree := "../../go-ontology-worktree-test"
mondo_worktree := "../mondo-worktree-test"
uberon_worktree := "../uberon-worktree-test"
oeo_worktree := "../../oeo-worktree-test"
efo_worktree := "../efo-worktree-test"
cl_worktree := "../cell-ontology-worktree-test"

# ============================================================================
# GO-ONTOLOGY
# ============================================================================

# Extract PRs from go-ontology
extract-go limit=default_limit:
    uv run ai4c-scribe extract {{go_repo}} -l {{limit}} -o data/prs-go-extracted-{{limit}}.jsonl

# Create review cases for go-ontology
cases-go limit=default_limit:
    uv run ai4c-scribe create-review-cases --include-all --include-implicit data/prs-go-extracted-{{limit}}.jsonl -o data/prs-go-cases-{{limit}}.jsonl

cases-go-md limit=default_limit:
    uv run ai4c-scribe create-review-cases --include-implicit data/prs-go-extracted-{{limit}}.jsonl -f markdown -o data/prs-go-cases-{{limit}}.md

cases-go-html limit=default_limit: cases-go
    uv run ai4c-scribe browse data/prs-go-cases-{{limit}}.jsonl -o app/go/

# Distill vignettes for go-ontology
distill-go limit=default_limit worktree=go_worktree:
    uv run ai4c-scribe distill -w {{worktree}} data/prs-go-cases-{{limit}}.jsonl -o vignettes/go -vv

# Full pipeline for go-ontology
all-go limit=default_limit worktree=go_worktree: (extract-go limit) (cases-go limit) (distill-go limit worktree)

# ============================================================================
# MONDO
