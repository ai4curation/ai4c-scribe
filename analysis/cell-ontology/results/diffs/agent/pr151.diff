diff --git a/src/patterns/dosdp-patterns/cuboidalEpithelialCell.yaml b/src/patterns/dosdp-patterns/cuboidalEpithelialCell.yaml
new file mode 100644
index 000000000..cc4d419ea
--- /dev/null
+++ b/src/patterns/dosdp-patterns/cuboidalEpithelialCell.yaml
@@ -0,0 +1,40 @@
+pattern_name: cuboidalEpithelialCell
+pattern_iri: http://purl.obolibrary.org/obo/cl/cuboidalEpithelialCell
+
+description: An epithelial cell characterized by a roughly cube-shaped morphology. Cuboidal epithelial cells are typically found in ducts and glands where they play a role in secretion and absorption.
+
+contributors:
+  - https://orcid.org/0000-0001-5208-3432
+
+classes:
+  epithelial cell: "CL:0000066"
+  cuboid: "PATO:0001872"
+
+relations:
+  has characteristic: "RO:0000053"
+
+vars:
+  location: "'location'"
+
+name:
+  text: "%s cuboidal epithelial cell"
+  vars:
+    - location
+
+def:
+  text: "A cuboidal epithelial cell that is located in the %s."
+  vars:
+    - location
+
+annotationProperties:
+  related_synonym: "oio:hasRelatedSynonym"
+
+annotations:
+  - annotationProperty: related_synonym
+    text: "%s cuboidal cell"
+    vars:
+      - location
+
+equivalentTo:
+  text: "'epithelial cell' and ('has characteristic' some 'cuboid')"
+  vars: []
