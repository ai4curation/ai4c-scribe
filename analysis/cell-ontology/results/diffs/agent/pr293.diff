new file mode 100755
index 000000000..6704b857c
--- /dev/null
+++ b/docs/check_no_imported_annotation_property_relabels.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ontology_file="${1:-src/ontology/cl-edit.owl}"
+pattern='AnnotationAssertion\(rdfs:label oboInOwl:'
+
+if rg -n "${pattern}" "${ontology_file}"; then
+  echo
+  echo "Found forbidden relabelling of imported oboInOwl annotation properties in ${ontology_file}."
+  echo "Remove those rdfs:label assertions from cl-edit.owl; the labels come from imports."
+  exit 1
+fi
+
+echo "No imported oboInOwl annotation property relabelling found in ${ontology_file}."
